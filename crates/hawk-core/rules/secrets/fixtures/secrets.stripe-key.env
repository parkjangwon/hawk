# NOTE: use Stripe's non-secret test prefix in fixtures. Live-format keys
# (sk_live_/rk_live_) trip GitHub Push Protection even when the body is an
# obvious dummy, and test keys cannot move real money anyway.
# ruleid: secrets.stripe-key
STRIPE_API_KEY=sk_test_00000000000000000000000000
# ok: secrets.stripe-key
STRIPE_WEBHOOK_SECRET_HEADER_NAME=stripe-signature
